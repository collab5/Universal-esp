-- NO HEAD / HEADLESS UNIVERSAL
-- R6, R15, dan custom rig.
-- ==================================================
local noHeadState={}
local noHeadConnection

local function IsWhitelistHeadAccessory(acc)
    if not acc or not acc:IsA("Accessory") then return false end
    local n=string.lower(acc.Name:gsub("[%s_%-%:]", ""))
    return n=="chinahat"
        or n=="8bitroyalcrown"
        or n:find("chinahat")~=nil
        or n:find("8bitroyalcrown")~=nil
end

local function SaveNoHeadState(obj)
    if noHeadState[obj] then return end
    if obj:IsA("BasePart") then
        noHeadState[obj]={kind="part",Transparency=obj.Transparency,LocalTransparencyModifier=obj.LocalTransparencyModifier}
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        noHeadState[obj]={kind="decal",Transparency=obj.Transparency}
    end
end

local function RestoreNoHead()
    for obj,state in pairs(noHeadState) do
        if obj and obj.Parent then
            if state.kind=="part" and obj:IsA("BasePart") then
                obj.Transparency=state.Transparency
                obj.LocalTransparencyModifier=state.LocalTransparencyModifier
            elseif state.kind=="decal" and (obj:IsA("Decal") or obj:IsA("Texture")) then
                obj.Transparency=state.Transparency
            end
        end
    end
    table.clear(noHeadState)
end

local function HideNoHeadObject(obj)
    if not obj or not obj.Parent then return end
    if obj:IsA("BasePart") then
        obj.Transparency=1
        obj.LocalTransparencyModifier=1
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        obj.Transparency=1
    end
end

local function ApplyNoHeadOnce()
    local char=LocalPlayer.Character
    if not char then return end

    local head=char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        SaveNoHeadState(head)
        HideNoHeadObject(head)
        for _,child in ipairs(head:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") then
                SaveNoHeadState(child)
                HideNoHeadObject(child)
            end
        end
    end

    for _,acc in ipairs(char:GetChildren()) do
        if acc:IsA("Accessory") and not IsWhitelistHeadAccessory(acc) then
            local handle=acc:FindFirstChild("Handle") or acc:FindFirstChildWhichIsA("BasePart",true)
            if handle and handle:IsA("BasePart") then
                local n=string.lower(acc.Name)
                local headAccessory=(
                    n:find("hair")~=nil or
                    n:find("hat")~=nil or
                    n:find("head")~=nil or
                    n:find("face")~=nil or
                    n:find("mask")~=nil or
                    n:find("crown")~=nil or
                    handle:FindFirstChild("HatAttachment")~=nil or
                    handle:FindFirstChild("HairAttachment")~=nil or
                    handle:FindFirstChild("FaceFrontAttachment")~=nil or
                    handle:FindFirstChild("FaceCenterAttachment")~=nil or
                    handle:FindFirstChild("NeckAttachment")~=nil
                )
                if headAccessory then
                    SaveNoHeadState(handle)
                    HideNoHeadObject(handle)
                    for _,child in ipairs(handle:GetDescendants()) do
                        if child:IsA("BasePart") or child:IsA("Decal") or child:IsA("Texture") then
                            SaveNoHeadState(child)
                            HideNoHeadObject(child)
                        end
                    end
                end
            end
        end
    end
end

local function SetNoHead(enabled)
    if noHeadConnection then
        noHeadConnection:Disconnect()
        noHeadConnection=nil
    end

    if not enabled then
        RestoreNoHead()
        return
    end

    ApplyNoHeadOnce()
    noHeadConnection=RunService.Heartbeat:Connect(function()
        if Toggles.NoHead then ApplyNoHeadOnce() end
    end)
end

