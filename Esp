local hudConnections={}
local hudStatusHooked={}
local hudLocked={}
local hudLastHook={}
local hudLastProgress={}
local function hudTrack(c) table.insert(hudConnections,c) end
local function removeAmountText(frame)
    if not frame or frame:GetAttribute("VexVAmountHooked") then return end
    frame:SetAttribute("VexVAmountHooked",true)
    local function apply(label)
        if not label:IsA("TextLabel") then return end
        label.Text=""; label.Visible=false
        hudTrack(label:GetPropertyChangedSignal("Text"):Connect(function() if label.Text~="" then label.Text="" end end))
        hudTrack(label:GetPropertyChangedSignal("Visible"):Connect(function() if label.Visible then label.Visible=false end end))
    end
    local amount=frame:FindFirstChild("amount")
    if amount then apply(amount) end
    hudTrack(frame.ChildAdded:Connect(function(child) if child.Name=="amount" then apply(child) end end))
end
local function hookStatusEffects(survivor)
    if hudStatusHooked[survivor] then return end
    hudStatusHooked[survivor]=true
    local function process(status)
        for _,folderName in ipairs({"Buff","Debuff"}) do
            local folder=status:FindFirstChild(folderName)
            local function hookFolder(f)
                for name in pairs({Repairboost=true,Repairnerf=true,Slow=true,Speed=true}) do
                    local frame=f:FindFirstChild(name)
                    if frame then removeAmountText(frame) end
                end
                hudTrack(f.ChildAdded:Connect(function(child)
                    if child.Name=="Repairboost" or child.Name=="Repairnerf" or child.Name=="Slow" or child.Name=="Speed" then removeAmountText(child) end
                end))
            end
            if folder then hookFolder(folder) else hudTrack(status.ChildAdded:Connect(function(child) if child.Name==folderName then hookFolder(child) end end)) end
        end
    end
    local status=survivor:FindFirstChild("statuseffects")
    if status then process(status) else hudTrack(survivor.ChildAdded:Connect(function(c) if c.Name=="statuseffects" then process(c) end end)) end
end
local function cacheHudPlayer(p,name)
    if not p then return end
    local hc=p:GetAttribute("HookCount")
    local hp=p:GetAttribute("HookedProgress")
    if hc~=nil then
        hudLastHook[name]=hc
        hudLastProgress[name]=hp or 1
    end
end
local function updateHudIcons()
    if not Toggles.HUDEnabled then return end
    local gui=LocalPlayer:FindFirstChild("PlayerGui")
    local survivor=gui and gui:FindFirstChild("Survivor")
    if not survivor then return end
    hookStatusEffects(survivor)
    local frame=survivor:FindFirstChild("Frame")
    if not frame then return end
    for i=1,5 do
        local slot=frame:FindFirstChild("Survivor"..i)
        if slot then
            local avatar=slot:FindFirstChild("ImageLabel")
            local nameLabel=slot:FindFirstChild("TextLabel")
            local blood=slot:FindFirstChild("blood")
            local anti=slot:FindFirstChild("Antiheal")
            if anti and anti:IsA("ImageLabel") then anti.Image=BROKEN_ICON end
            if avatar and nameLabel and nameLabel.Text~="" and nameLabel.Text~="Label" then
                local name=nameLabel.Text
                local p=Players:FindFirstChild(name)
                local char=p and Workspace:FindFirstChild(name)
                if p then cacheHudPlayer(p,name) end
                local hc=p and p:GetAttribute("HookCount") or (char and char:GetAttribute("HookCount"))
                local hp=p and p:GetAttribute("HookedProgress") or (char and char:GetAttribute("HookedProgress"))
                if hc~=nil then hudLastHook[name]=hc; hudLastProgress[name]=hp or 1 end
                local icon=HEALTHY_ICON
                if hudLocked[name] then
                    icon=hudLocked[name]
                elseif not p then
                    icon=DISCONNECT_ICON
                    if hudLastHook[name]~=nil then hudLocked[name]=icon end
                elseif p.Team and p.Team.Name=="Spectators" then
                    if (hudLastHook[name] or hc or 0)>=3 or (hudLastProgress[name] or hp or 1)<=0 then icon=DEAD_ICON else icon=ESCAPE_ICON end
                    if hudLastHook[name]~=nil then hudLocked[name]=icon end
                elseif (hc or 0)>=3 or (hp or 1)<=0 then
                    icon=DEAD_ICON
                    hudLocked[name]=icon
                elseif char and char:GetAttribute("IsHooked") then
                    icon=HOOK_ICON
                elseif char and char:GetAttribute("Knocked") then
                    icon=DOWN_ICON
                elseif blood and blood.Visible then
                    icon=HURT_ICON
                end
                avatar.Image=icon
                avatar.ImageColor3=Color3.fromRGB(255,255,255)
                if not avatar:GetAttribute("VexVHudSized") then
                    avatar.Size=UDim2.new(avatar.Size.X.Scale*1.15,avatar.Size.X.Offset*1.15,avatar.Size.Y.Scale*1.15,avatar.Size.Y.Offset*1.15)
                    avatar.ImageTransparency=0
                    avatar:SetAttribute("VexVHudSized",true)
                end
            end
        end
    end
    local gen=survivor:FindFirstChild("Gen")
    local genholder=gen and gen:FindFirstChild("genholder")
    local genImage=genholder and genholder:FindFirstChild("ImageLabel")
    if genImage and genImage:IsA("ImageLabel") then
        genImage.Image=GEN_ICON
        genImage.ScaleType=Enum.ScaleType.Fit
        genImage.ImageTransparency=0
        if not genImage:GetAttribute("VexVGeneratorSized") then
            genImage.Size=UDim2.new(genImage.Size.X.Scale*1.5,genImage.Size.X.Offset*1.5,genImage.Size.Y.Scale*1.5,genImage.Size.Y.Offset*1.5)
            genImage:SetAttribute("VexVGeneratorSized",true)
        end
    end
    local itemFrame=gen and gen:FindFirstChild("ItemFrame")
    local itemGui=itemFrame and itemFrame:FindFirstChild("Gui")
    local char=LocalPlayer.Character
    if itemGui and itemGui:IsA("ImageLabel") and char then
        if char:FindFirstChild("Bandage") then itemGui.Image=MEDKIT_ICON elseif char:FindFirstChild("Flashlight") then itemGui.Image=FLASHLIGHT_ICON end
    end
