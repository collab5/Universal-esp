-- Camera Modifier: basis CameraBlock dari script V5 yang dipilih
local cameraModifierConnection
local CameraBlock
local smoothedPos
local STIFFNESS_DEFAULT=7
local CAMERA_HEIGHT_DEFAULT=-3
local function CleanupCameraBlock()
    if cameraModifierConnection then
        cameraModifierConnection:Disconnect()
        cameraModifierConnection=nil
    end
    if CameraBlock then
        CameraBlock:Destroy()
        CameraBlock=nil
    end
    local hum=GetHumanoid()
    if hum and Camera then
        Camera.CameraSubject=hum
    end
end
local function SetupCameraModifier()
    CleanupCameraBlock()
    local character=LocalPlayer.Character
    local hum=character and character:FindFirstChildOfClass("Humanoid")
    local head=character and character:FindFirstChild("Head")
    if not character or not hum or not head then return end
    CameraBlock=Instance.new("Part")
    CameraBlock.Name="CameraBlock"
    CameraBlock.Size=Vector3.new(1,1,1)
    CameraBlock.Transparency=1
    CameraBlock.LocalTransparencyModifier=1
    CameraBlock.CastShadow=false
    CameraBlock.CanQuery=false
    CameraBlock.CanTouch=false
    CameraBlock.CanCollide=false
    CameraBlock.Anchored=true
    CameraBlock.Parent=Workspace
    smoothedPos=head.Position+Vector3.new(0,hum.HipHeight-(Options.CameraHeight or CAMERA_HEIGHT_DEFAULT),0)
    cameraModifierConnection=RunService.RenderStepped:Connect(function(dt)
        if not Toggles.CameraModifier then return end
        local c=LocalPlayer.Character
        local h=c and c:FindFirstChild("Head")
        local hm=c and c:FindFirstChildOfClass("Humanoid")
        if not h or not hm or not CameraBlock then return end
        local targetPos=h.Position+Vector3.new(0,hm.HipHeight-(Options.CameraHeight or CAMERA_HEIGHT_DEFAULT),0)
        local alpha=1-math.exp(-(Options.Stiffness or STIFFNESS_DEFAULT)*dt)
        smoothedPos=smoothedPos:Lerp(targetPos,alpha)
        CameraBlock.CFrame=CFrame.new(smoothedPos)
        Camera.CameraSubject=CameraBlock
    end)
end
