    label.Parent=gui

    task.spawn(function()
        local ok,image=pcall(function()
            return Players:GetUserThumbnailAsync(
                player.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size100x100
            )
        end)
        if ok and profile.Parent then
            profile.Image=image
        end
    end)

    espEntries[player]={highlight=hl,gui=gui}
end

local function RefreshESP(player)
    if not player or player==LocalPlayer or not Toggles.ESP_simple then return end
    task.spawn(function()
        for i=1,5 do
            if not Toggles.ESP_simple then return end
            local char=player.Character
            if GetESPAnchor(char) then
                AddESP(player)
                return
            end
            task.wait(0.2*i)
        end
    end)
end

local function BindUniversalESPPlayer(player)
    if player==LocalPlayer then return end

    table.insert(Connections,player.CharacterAdded:Connect(function()
        RemoveESP(player)
        RefreshESP(player)
    end))

    table.insert(Connections,player.CharacterAppearanceLoaded:Connect(function()
        RefreshESP(player)
    end))

    RefreshESP(player)
end

local function SetESP(enabled)
    Toggles.ESP_simple=enabled
    for player in pairs(espEntries) do RemoveESP(player) end
    if not enabled then return end
    for _,player in ipairs(Players:GetPlayers()) do
        BindUniversalESPPlayer(player)
    end
end

