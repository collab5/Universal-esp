local function SetHandLaser(state)
    ClearHandLaser()
    if not state or not Toggles.HandLaser then return end

    local hand=GetRightHand()
    if not hand then return end

    local a0=Instance.new("Attachment")
    a0.Name="CosmeticLaserOrigin"
    a0.Position=Vector3.new(0,-0.45,-0.15)
    a0.Parent=hand
    handLaserAttachment0=a0

    local endpoint=Instance.new("Part")
    endpoint.Name="CosmeticLaserEnd"
    endpoint.Size=Vector3.new(0.1,0.1,0.1)
    endpoint.Transparency=1
    endpoint.Anchored=true
    endpoint.CanCollide=false
    endpoint.CanTouch=false
    endpoint.CanQuery=false
    endpoint.Parent=workspace
    handLaserPart=endpoint

    local a1=Instance.new("Attachment")
    a1.Name="CosmeticLaserEndAttachment"
    a1.Parent=endpoint
    handLaserAttachment1=a1

    local beam=Instance.new("Beam")
    beam.Name="CosmeticHandBeam"
    beam.Attachment0=a0
    beam.Attachment1=a1
    beam.FaceCamera=true
    beam.LightEmission=1
    beam.LightInfluence=0
    beam.Transparency=NumberSequence.new(0.28)
    beam.Width0=Options.LaserThickness or 0.08
    beam.Width1=Options.LaserThickness or 0.08
    beam.Color=ColorSequence.new(Color3.fromRGB(185,0,255))
    beam.Parent=hand
    handLaserBeam=beam

    local laserLength=Options.LaserLength or 50
    local blackHoleDistance=laserLength*0.5
    local center=hand.Position+Vector3.new(0,-blackHoleDistance,0)
    CreateBlackHole(center)

    local startTime=os.clock()
    handLaserConnection=RunService.RenderStepped:Connect(function()
        local h=GetRightHand()
        if not h or not endpoint.Parent then
            ClearHandLaser()
            return
        end

        local length=Options.LaserLength or 50

        -- Origin mengikuti tangan kanan; arah mengikuti crosshair kamera.
        local cam=Workspace.CurrentCamera
        local ray
        if cam then
            local vp=cam.ViewportSize
            ray=cam:ViewportPointToRay(vp.X*0.5,vp.Y*0.5)
        end
        local direction=ray and ray.Direction or Vector3.new(0,-1,0)
        endpoint.CFrame=CFrame.lookAt(h.Position+direction*length,h.Position+direction*(length+1))

        local holeCenter=h.Position+direction*(length*0.5)
        blackHole.CFrame=CFrame.new(holeCenter)

        local t=os.clock()-startTime
        blackHoleRing.CFrame=
            CFrame.new(holeCenter) *
            CFrame.Angles(0,t*2.2,math.rad(90))

        local children=blackHoleStars:GetChildren()
        for i,star in ipairs(children) do
            local angle=t*(1.3+i*0.08)+(i/7)*math.pi*2
            local radius=1.8+((i%2)*0.35)
            star.CFrame=CFrame.new(
                holeCenter+
                Vector3.new(
                    math.cos(angle)*radius,
                    math.sin(angle*1.5)*0.25,
                    math.sin(angle)*radius
                )
            )
        end
    end)
end

