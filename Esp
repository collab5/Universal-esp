local function GetESPAnchor(char)
    if not char then return nil end
    local humanoid=char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end

    return char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChildWhichIsA("BasePart",true)
end

local espEntries={}
local function RemoveESP(player)
    local e=espEntries[player]
    if not e then return end
    if e.highlight then e.highlight:Destroy() end
    if e.gui then e.gui:Destroy() end
    espEntries[player]=nil
end

local function AddESP(player)
    if player==LocalPlayer or not Toggles.ESP_simple then return end
    local char=player.Character
    local anchor=GetESPAnchor(char)
    if not char or not anchor then
        return
    end

    RemoveESP(player)

    local hl=Instance.new("Highlight")
    hl.Name="VexV_ESP"
    hl.Adornee=char
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor=Color3.fromRGB(255,0,255)
    hl.FillTransparency=0.65
    hl.OutlineColor=Color3.fromRGB(255,255,255)
    hl.OutlineTransparency=0.35
    hl.Parent=universalESPFolder

    local gui=Instance.new("BillboardGui")
    gui.Name="VexV_ESP_Name"
    gui.Adornee=anchor
    gui.Size=UDim2.fromOffset(150,54)
    gui.StudsOffset=Vector3.new(0,3.15,0)
    gui.AlwaysOnTop=true
    gui.MaxDistance=10000
    gui.Parent=universalESPGui

    local profile=Instance.new("ImageLabel")
    profile.Name="ProfileImage"
    profile.Size=UDim2.fromOffset(30,30)
    profile.Position=UDim2.new(0.5,-15,0,0)
    profile.BackgroundTransparency=1
    profile.ScaleType=Enum.ScaleType.Fit
    profile.Parent=gui

    local label=Instance.new("TextLabel")
    label.Size=UDim2.new(1,0,0,24)
    label.Position=UDim2.new(0,0,0,31)
    label.BackgroundTransparency=1
    label.Text=player.Name
    label.TextColor3=Color3.fromRGB(230,230,230)
    label.TextSize=12
