        handLaserConnection:Disconnect()
        handLaserConnection=nil
    end
    if blackHoleConnection then
        blackHoleConnection:Disconnect()
        blackHoleConnection=nil
    end
    for _,o in ipairs({
        handLaserBeam,handLaserAttachment0,handLaserAttachment1,handLaserPart,
        blackHole,blackHoleRing,blackHoleStars
    }) do
        if o and o.Parent then o:Destroy() end
    end
    handLaserBeam=nil
    handLaserAttachment0=nil
    handLaserAttachment1=nil
    handLaserPart=nil
    blackHole=nil
    blackHoleRing=nil
    blackHoleStars=nil
end

local function CreateBlackHole(center)
    local hole=Instance.new("Part")
    hole.Name="CosmeticBlackHole"
