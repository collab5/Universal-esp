-- FPS Optimizer
-- Mengurangi texture dan efek visual, tetapi bisa dikembalikan

local fpsOriginal = {}

local function SaveState(obj, property, value)
    if not fpsOriginal[obj] then
        fpsOriginal[obj] = {}
    end

    if fpsOriginal[obj][property] == nil then
        fpsOriginal[obj][property] = value
    end
end

local function SetFPSOptimizer(enabled)
    if not enabled then
        -- RESTORE
        for obj, states in pairs(fpsOriginal) do
            if obj and obj.Parent then
                for property, value in pairs(states) do
                    pcall(function()
                        obj[property] = value
                    end)
                end
            end
        end

        fpsOriginal = {}
        return
    end

    fpsOriginal = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do

        -- Particle / Beam / Trail
        if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam") then

            SaveState(obj, "Enabled", obj.Enabled)
            obj.Enabled = false

        -- Texture / Decal
        elseif obj:IsA("Decal")
        or obj:IsA("Texture") then

            SaveState(obj, "Transparency", obj.Transparency)
            obj.Transparency = 1


        -- Lighting effects
        elseif obj:IsA("BloomEffect")
        or obj:IsA("BlurEffect")
        or obj:IsA("ColorCorrectionEffect")
        or obj:IsA("SunRaysEffect")
        or obj:IsA("DepthOfFieldEffect") then

            SaveState(obj, "Enabled", obj.Enabled)
            obj.Enabled = false

        -- Part material dibuat lebih ringan
        elseif obj:IsA("BasePart") then

            SaveState(obj, "Material", obj.Material)
            obj.Material = Enum.Material.SmoothPlastic

        end
    end
end

