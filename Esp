-- 8-Bit Royal Crown
-- Metode pemasangan dibuat mengikuti China Hat: Part lokal + SpecialMesh + Weld.
local ROYAL_CROWN_MESH_ID = "rbxassetid://10138606900"
local ROYAL_CROWN_TEXTURE_ID = "rbxassetid://10138606949"

local function RemoveRoyalCrown()
    local c = LocalPlayer.Character
    local crown = c and c:FindFirstChild("8BitRoyalCrown")
    if crown then crown:Destroy() end
end

function CreateRoyalCrown()
    local c = LocalPlayer.Character
    if not c then return end

    local head = GetCharacterHeadOrPart(c)
    if not head then return end

    RemoveRoyalCrown()

    local handle = Instance.new("Part")
    handle.Name = "8BitRoyalCrown"
    handle.Size = Vector3.new(3, 1.5, 3)
    handle.Anchored = false
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true
    handle.CastShadow = false
    handle.Transparency = 0

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = ROYAL_CROWN_MESH_ID
    mesh.TextureId = ROYAL_CROWN_TEXTURE_ID
    mesh.Scale = Vector3.new(2.2, 2.2, 2.2)
    mesh.Parent = handle

    -- Posisi dasar mengikuti pola China Hat.
    handle.CFrame = head.CFrame * CFrame.new(0, 1.05, 0)

    local weld = Instance.new("Weld")
    weld.Name = "RoyalCrownWeld"
    weld.Part0 = head
    weld.Part1 = handle
    weld.C0 = CFrame.new(0, 1.05, 0)
    weld.C1 = CFrame.new()
    weld.Parent = handle

    handle.Parent = c
    handle.LocalTransparencyModifier = 0
    -- Halloween fire source.
    -- Referensi visual: Halloween Flame Aura - Top, asset 5830573638.
    -- Jika client bisa memuat asset, hanya ParticleEmitter-nya yang diambil.
    local HALLOWEEN_FIRE_ASSET = "rbxassetid://5830573638"
    local loadedHalloweenEmitter=false

    local ok,objects=pcall(function()
        return game:GetObjects(HALLOWEEN_FIRE_ASSET)
    end)

    if ok and type(objects)=="table" then
        for _,root in ipairs(objects) do
            for _,desc in ipairs(root:GetDescendants()) do
                if desc:IsA("ParticleEmitter") then
                    local cloned=desc:Clone()
                    cloned.Name="RoyalCrownHalloweenFire"
                    cloned.Parent=handle
                    loadedHalloweenEmitter=true
                end
            end
            pcall(function() root:Destroy() end)
        end
    end

    -- Fallback jika katalog effect tidak bisa dimuat oleh client.
    if not loadedHalloweenEmitter then
        local fire=Instance.new("ParticleEmitter")
        fire.Name="RoyalCrownHalloweenFire"
        fire.Texture="rbxasset://textures/particles/fire_main.dds"
        fire.Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,Color3.fromRGB(255,248,210)),
            ColorSequenceKeypoint.new(0.35,Color3.fromRGB(255,150,25)),
            ColorSequenceKeypoint.new(0.70,Color3.fromRGB(255,55,15)),
            ColorSequenceKeypoint.new(1,Color3.fromRGB(115,10,5))
        })
        fire.LightEmission=1
        fire.LightInfluence=0
        fire.Rate=34
        fire.Lifetime=NumberRange.new(0.35,0.8)
        fire.Speed=NumberRange.new(0.3,1.2)
        fire.SpreadAngle=Vector2.new(25,25)
        fire.Rotation=NumberRange.new(0,360)
        fire.RotSpeed=NumberRange.new(-90,90)
        fire.Size=NumberSequence.new({
            NumberSequenceKeypoint.new(0,0.35),
            NumberSequenceKeypoint.new(0.35,0.95),
            NumberSequenceKeypoint.new(0.8,0.55),
            NumberSequenceKeypoint.new(1,0)
        })
        fire.Transparency=NumberSequence.new({
            NumberSequenceKeypoint.new(0,0.05),
            NumberSequenceKeypoint.new(0.75,0.25),
            NumberSequenceKeypoint.new(1,1)
        })
        fire.Parent=handle
    end

    local fireGlow=Instance.new("PointLight")
    fireGlow.Name="RoyalCrownHalloweenFireGlow"
    fireGlow.Color=Color3.fromRGB(255,100,25)
    fireGlow.Brightness=1.0
    fireGlow.Range=6
    fireGlow.Shadows=false
    fireGlow.Parent=handle
end

