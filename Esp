-- Mengikuti metode matrix asli 0.46, tetapi dieksekusi sesudah Camera update
-- agar tidak menumpuk antar-frame dan tidak berebut dengan Mode 4:3.
-- ==================================================
local screenStretchBound=false
local SCREEN_STRETCH_DEFAULT=0.46

local function ClearScreenStretch()
    if screenStretchBound then
        pcall(function() RunService:UnbindToRenderStep("VexV_ScreenStretch") end)
        screenStretchBound=false
    end
end

local function ApplyScreenStretch()
    ClearScreenStretch()
    pcall(function()
        RunService:BindToRenderStep("VexV_ScreenStretch", Enum.RenderPriority.Camera.Value + 1, function()
            if not Toggles.ScreenStretch then return end
            local cam=Workspace.CurrentCamera
            if not cam then return end
            local resolution=math.clamp(tonumber(Options.ScreenStretchAmount) or SCREEN_STRETCH_DEFAULT,0.10,1.00)
            pcall(function()
                local base=cam.CFrame
                cam.CFrame=base*CFrame.new(
                    0,0,0,
                    1,0,0,
                    0,resolution,0,
                    0,0,1
                )
            end)
        end)
        screenStretchBound=true
    end)
end

